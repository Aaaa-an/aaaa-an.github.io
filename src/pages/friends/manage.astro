---
import { Icon } from "astro-icon/components";
import { friendsSystemConfig, siteConfig } from "@/config";
import friendsData from "@/data/friends.json";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { assertFriendsData } from "@/utils/friends-data";
import "@/styles/pages/common.css";
import "@/styles/pages/friends.css";

if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}
assertFriendsData(friendsData);
const repositoryConfigured = Boolean(friendsSystemConfig.repository);
---

<MainGridLayout title="友链管理" description="本地可视化编辑，使用 GitHub 身份和仓库权限创建数据 PR。">
	<friend-manager
		class="block space-y-4"
		data-initial={JSON.stringify(friendsData)}
		data-repository={friendsSystemConfig.repository}
		data-template={friendsSystemConfig.adminTemplate}
		data-default-logo={friendsSystemConfig.defaultLogo}
	>
		<div class="card-base z-10 px-6 md:px-9 py-7 relative w-full">
			<div class="page-heading mb-4">
				<div class="page-icon" aria-hidden="true"><Icon name="material-symbols:settings-account-box-rounded" /></div>
				<div>
					<h2>友链可视化管理</h2>
					<p>此页面本身不是登录边界；真正写入由 GitHub 对管理员身份与仓库权限进行校验。</p>
				</div>
			</div>

			{!repositoryConfigured && (
				<div class="friends-notice friends-notice-warning" role="status">
					<Icon name="material-symbols:warning-outline-rounded" />
					<div><strong>尚未配置目标仓库</strong><p>本地增删改、排序、校验和导入导出可用；GitHub 保存与待审核列表会保持禁用。</p></div>
				</div>
			)}

			<div class="friends-manager-toolbar">
				<button type="button" data-action="new" class="btn-regular rounded-xl px-4 py-2 inline-flex items-center gap-2"><Icon name="material-symbols:add-link-rounded" />直接添加</button>
				<button type="button" data-action="import" class="btn-regular rounded-xl px-4 py-2 inline-flex items-center gap-2"><Icon name="material-symbols:upload-file-rounded" />导入 JSON</button>
				<button type="button" data-action="export" class="btn-regular rounded-xl px-4 py-2 inline-flex items-center gap-2"><Icon name="material-symbols:download-rounded" />导出 JSON</button>
				<a data-pending-link class="btn-regular rounded-xl px-4 py-2 inline-flex items-center gap-2" aria-disabled={!repositoryConfigured}><Icon name="material-symbols:pending-actions-rounded" />待审核申请</a>
				<input data-import-file type="file" accept="application/json,.json" class="hidden" />
			</div>
			<div data-validation class="friends-form-status" role="status" aria-live="polite"></div>
		</div>

		<div class="card-base z-10 px-6 md:px-9 py-7 relative w-full">
			<form data-editor class="friends-form-grid hidden" novalidate>
				<input type="hidden" name="editingId" />
				<label><span>网站名称 <em>*</em></span><input name="title" required maxlength="80" /></label>
				<label><span>网站 URL <em>*</em></span><input name="siteurl" required type="url" /></label>
				<label><span>头像 / Logo URL</span><input name="imgurl" type="text" /></label>
				<label><span>标签</span><input name="tags" placeholder="Blog, 技术" /></label>
				<label><span>排序权重</span><input name="weight" type="number" min="-10000" max="10000" step="1" value="0" /></label>
				<label class="friends-checkbox"><input name="enabled" type="checkbox" checked /><span>公开显示</span></label>
				<label class="friends-form-wide"><span>简介</span><textarea name="description" maxlength="200" rows="3"></textarea></label>
				<div class="friends-form-wide flex flex-wrap gap-2">
					<button type="submit" class="btn-regular friends-primary-action rounded-xl px-5 py-2">保存到本地草稿</button>
					<button type="button" data-action="cancel" class="btn-regular rounded-xl px-4 py-2">取消</button>
				</div>
			</form>
			<div data-empty class="friends-manager-empty">当前没有友链。点击“直接添加”创建第一条记录。</div>
			<div data-list class="friends-manager-list"></div>
		</div>

		<div class="card-base z-10 px-6 md:px-9 py-7 relative w-full">
			<h3 class="text-xl font-bold mb-2">提交 GitHub 变更</h3>
			<p class="text-sm text-neutral-500 dark:text-neutral-400 mb-4">按钮会打开 GitHub 官方 Issue Form，并预填经过校验的完整 JSON。只有 GitHub 用户 <code>{friendsSystemConfig.adminGitHubLogin}</code> 且具有仓库写权限时，Actions 才会创建 PR。</p>
			<div class="flex flex-wrap gap-2">
				<button type="button" data-action="github-save" class="btn-regular friends-primary-action rounded-xl px-5 py-2.5 inline-flex items-center gap-2" disabled={!repositoryConfigured}>
					<Icon name="fa7-brands:github" />在 GitHub 创建管理请求
				</button>
				<a href="/friends/" class="btn-regular rounded-xl px-4 py-2.5">返回友链页面</a>
			</div>
			<div data-github-status class="friends-form-status hidden mt-3" role="status" aria-live="polite"></div>
		</div>
	</friend-manager>
</MainGridLayout>

<script>
	import type { FriendRecord, FriendsDataFile } from "@/types/friendsConfig";
	import {
		applyFriendOperation,
		exportFriendsJson,
		parseFriendsJson,
		sortFriendRecords,
		validateFriendsData,
	} from "@/utils/friends-data";

	if (!customElements.get("friend-manager")) {
		class FriendManager extends HTMLElement {
			draft!: FriendsDataFile;
			baseRevision = 0;
			form!: HTMLFormElement;
			list!: HTMLElement;
			validation!: HTMLElement;
			repository = "";
			template = "";
			defaultLogo = "";

			connectedCallback() {
				this.draft = JSON.parse(this.dataset.initial || '{"version":1,"revision":0,"friends":[]}');
				this.baseRevision = this.draft.revision;
				this.repository = this.dataset.repository || "";
				this.template = this.dataset.template || "";
				this.defaultLogo = this.dataset.defaultLogo || "";
				this.form = this.querySelector("[data-editor]") as HTMLFormElement;
				this.list = this.querySelector("[data-list]") as HTMLElement;
				this.validation = this.querySelector("[data-validation]") as HTMLElement;
				this.addEventListener("click", this.handleClick);
				this.form.addEventListener("submit", this.handleSubmit);
				(this.querySelector("[data-import-file]") as HTMLInputElement).addEventListener("change", this.handleImport);
				const pending = this.querySelector("[data-pending-link]") as HTMLAnchorElement;
				if (this.repository) pending.href = `https://github.com/${this.repository}/issues?q=is%3Aissue+label%3Afriends%3Apending`;
				this.render();
			}

			disconnectedCallback() {
				this.removeEventListener("click", this.handleClick);
				this.form.removeEventListener("submit", this.handleSubmit);
			}

			handleClick = (event: Event) => {
				const button = (event.target as HTMLElement).closest<HTMLElement>("[data-action]");
				if (!button) return;
				const action = button.dataset.action;
				const id = button.dataset.id || "";
				if (action === "new") this.openEditor();
				if (action === "cancel") this.closeEditor();
				if (action === "edit") this.openEditor(id);
				if (action === "toggle") this.update(() => applyFriendOperation(this.draft, { operation: "set-enabled", id, enabled: button.dataset.enabled !== "true" }));
				if (action === "delete" && window.confirm("确定删除这条友链吗？该操作仍需通过 GitHub PR 合并才会公开生效。")) {
					this.update(() => applyFriendOperation(this.draft, { operation: "delete", id }));
				}
				if (action === "up" || action === "down") this.move(id, action === "up" ? -1 : 1);
				if (action === "import") (this.querySelector("[data-import-file]") as HTMLInputElement).click();
				if (action === "export") this.exportData();
				if (action === "github-save") this.openGitHubRequest();
			};

			handleSubmit = (event: SubmitEvent) => {
				event.preventDefault();
				const values = new FormData(this.form);
				const editingId = String(values.get("editingId") || "");
				const friend = {
					title: String(values.get("title") || "").trim(),
					siteurl: String(values.get("siteurl") || "").trim(),
					imgurl: String(values.get("imgurl") || "").trim(),
					description: String(values.get("description") || "").trim(),
					tags: String(values.get("tags") || "").split(/[,，]/).map((tag) => tag.trim()).filter(Boolean),
					weight: Number(values.get("weight") || 0),
					enabled: values.get("enabled") === "on",
				};
				this.update(() => editingId
					? applyFriendOperation(this.draft, { operation: "update", id: editingId, patch: friend })
					: applyFriendOperation(this.draft, { operation: "add", friend }));
				if (validateFriendsData(this.draft).valid) this.closeEditor();
			};

			handleImport = async (event: Event) => {
				const input = event.currentTarget as HTMLInputElement;
				const file = input.files?.[0];
				if (!file) return;
				this.update(async () => parseFriendsJson(await file.text()));
				input.value = "";
			};

			update(factory: () => FriendsDataFile | Promise<FriendsDataFile>) {
				Promise.resolve().then(factory).then((next) => {
					this.draft = next;
					this.render();
				}).catch((error) => {
					this.validation.classList.remove("is-success");
					this.validation.textContent = error instanceof Error ? error.message : String(error);
				});
			}

			openEditor(id = "") {
				this.form.reset();
				(this.form.elements.namedItem("editingId") as HTMLInputElement).value = id;
				(this.form.elements.namedItem("enabled") as HTMLInputElement).checked = true;
				if (id) {
					const friend = this.draft.friends.find((item) => item.id === id);
					if (!friend) return;
					for (const key of ["title", "siteurl", "imgurl", "description", "weight"] as const) {
						(this.form.elements.namedItem(key) as HTMLInputElement).value = String(friend[key]);
					}
					(this.form.elements.namedItem("tags") as HTMLInputElement).value = friend.tags.join(", ");
					(this.form.elements.namedItem("enabled") as HTMLInputElement).checked = friend.enabled;
				}
				this.form.classList.remove("hidden");
				(this.form.elements.namedItem("title") as HTMLInputElement).focus();
			}

			closeEditor() {
				this.form.classList.add("hidden");
				this.form.reset();
			}

			move(id: string, offset: number) {
				const sorted = sortFriendRecords(this.draft.friends);
				const index = sorted.findIndex((friend) => friend.id === id);
				const target = index + offset;
				if (index < 0 || target < 0 || target >= sorted.length) return;
				[sorted[index], sorted[target]] = [sorted[target] as FriendRecord, sorted[index] as FriendRecord];
				this.update(() => applyFriendOperation(this.draft, { operation: "reorder", ids: sorted.map((friend) => friend.id) }));
			}

			exportData() {
				try {
					const blob = new Blob([exportFriendsJson(this.draft)], { type: "application/json" });
					const link = document.createElement("a");
					link.href = URL.createObjectURL(blob);
					link.download = `friends-${new Date().toISOString().slice(0, 10)}.json`;
					link.click();
					URL.revokeObjectURL(link.href);
				} catch (error) {
					this.validation.textContent = error instanceof Error ? error.message : String(error);
				}
			}

			openGitHubRequest() {
				const status = this.querySelector("[data-github-status]") as HTMLElement;
				status.classList.remove("hidden", "is-success");
				const result = validateFriendsData(this.draft);
				if (!result.valid) {
					status.textContent = `无法提交：${result.errors.map((item) => `${item.path}: ${item.message}`).join("；")}`;
					return;
				}
				if (!this.repository) {
					status.textContent = "目标 GitHub 仓库尚未配置，没有创建管理请求。";
					return;
				}
				const url = new URL(`https://github.com/${this.repository}/issues/new`);
				url.searchParams.set("template", this.template);
				url.searchParams.set("title", `[友链管理] ${new Date().toISOString().slice(0, 10)} 数据更新`);
				url.searchParams.set("operation-payload", JSON.stringify({ operation: "replace", baseRevision: this.baseRevision, data: this.draft }, null, 2));
				url.searchParams.set("note", "由 A's Blog 友链可视化管理器生成。请在提交前再次检查 JSON。 ");
				window.open(url, "_blank", "noopener,noreferrer");
				status.classList.add("is-success");
				status.textContent = "GitHub 页面已打开。只有在 GitHub 提交 Issue、Actions 创建 PR 且管理员合并后，数据才会生效。";
			}

			render() {
				const result = validateFriendsData(this.draft);
				this.validation.classList.toggle("is-success", result.valid);
				this.validation.textContent = result.valid
					? `本地草稿校验通过：${this.draft.friends.length} 条友链，其中 ${this.draft.friends.filter((friend) => friend.enabled).length} 条已启用。`
					: result.errors.map((item) => `${item.path}: ${item.message}`).join("；");
				const empty = this.querySelector("[data-empty]") as HTMLElement;
				empty.classList.toggle("hidden", this.draft.friends.length > 0);
				this.list.replaceChildren(...sortFriendRecords(this.draft.friends).map((friend, index, all) => this.createCard(friend, index, all.length)));
			}

			createCard(friend: FriendRecord, index: number, total: number) {
				const card = document.createElement("article");
				card.className = "friends-manager-card";
				const image = document.createElement("img");
				image.src = friend.imgurl || this.defaultLogo;
				image.alt = "";
				image.addEventListener("error", () => { image.src = this.defaultLogo; }, { once: true });
				const body = document.createElement("div");
				body.className = "friends-manager-card-body";
				const heading = document.createElement("strong");
				heading.textContent = friend.title;
				const url = document.createElement("span");
				url.textContent = friend.siteurl;
				const meta = document.createElement("small");
				meta.textContent = `${friend.enabled ? "已启用" : "已禁用"} · 权重 ${friend.weight} · ${friend.tags.join(" / ") || "无标签"}`;
				body.append(heading, url, meta);
				const actions = document.createElement("div");
				actions.className = "friends-manager-card-actions";
				const specs: Array<[string, string, boolean?]> = [
					["edit", "编辑"], ["toggle", friend.enabled ? "禁用" : "启用"],
					["up", "上移", index === 0], ["down", "下移", index === total - 1], ["delete", "删除"],
				];
				for (const [action, label, disabled] of specs) {
					const button = document.createElement("button");
					button.type = "button";
					button.className = action === "delete" ? "friends-danger-action" : "btn-regular";
					button.dataset.action = action;
					button.dataset.id = friend.id;
					button.dataset.enabled = String(friend.enabled);
					button.disabled = Boolean(disabled);
					button.textContent = label;
					actions.append(button);
				}
				card.append(image, body, actions);
				return card;
			}
		}
		customElements.define("friend-manager", FriendManager);
	}
</script>
